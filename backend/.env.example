DATABASE_URL=postgresql://postgres:your-password@db.your-project.supabase.co:5432/postgres
PORT=4000
X402_API_KEY=your-x402-celo-facilitator-api-key
X402_PAYTO_WALLET=0x0000000000000000000000000000000000000000
PAYER_PRIVATE_KEY=0xyour-dedicated-payer-wallet-private-key

# USDC charged per unit of metered usage. Leaving this unset falls back to a
# demo-safe default, so the failure mode of forgetting it is an underspend
# rather than a drained wallet. Set it explicitly in any real deployment.
WATER_RATE_USDC=0.0001

# Shared secret the dashboard sends as the X-Api-Key header. The session
# endpoints spend real USDC from the payer wallet, so the service refuses to
# start without this. Generate one with:
#   head -c 32 /dev/urandom | base64 | tr -d '=+/' | cut -c1-40
API_SHARED_SECRET=your-generated-shared-secret

# Comma-separated list of browser origins allowed to call the API. Never use a
# wildcard: it lets any site on the internet drive the endpoints that spend.
CORS_ORIGIN=http://localhost:3000

# Hard ceiling on any single session's spending limit, in USDC. Keep this below
# the payer wallet balance so a typo cannot drain it.
MAX_SPENDING_LIMIT_USDC=0.25
