# Base URL of the Tapa agent service. A production build FAILS if this is not
# set, rather than silently falling back to localhost and looking merely offline.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Must match API_SHARED_SECRET in the backend environment. Sent as X-Api-Key.
# NEXT_PUBLIC_ values are embedded in the client bundle, so treat this as a gate
# against casual and automated traffic, not as a secret from a determined user.
# A production build also fails if this is not set.
NEXT_PUBLIC_API_KEY=your-generated-shared-secret
